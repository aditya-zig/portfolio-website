---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
---

<section id="about" class="border-t border-border">
  <div
    class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8"
  >
    <SectionHeading
      index="02"
      title="About"
      note="First-year Information Science Engineering student building practical software in Bangalore, India."
    />

    <div class="mt-12 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="text-base leading-relaxed text-muted sm:text-lg">
          {siteConfig.aboutMe}
        </p>

        <dl class="mt-10 space-y-4 border-t border-border pt-6 text-sm">
          <div class="flex items-start justify-between gap-6">
            <dt class="text-muted">Location</dt>
            <dd class="text-right text-text">{siteConfig.location}</dd>
          </div>
          <div class="flex items-start justify-between gap-6">
            <dt class="text-muted">Education</dt>
            <dd class="text-right text-text">{siteConfig.educationShort}</dd>
          </div>
          <div class="flex items-start justify-between gap-6">
            <dt class="text-muted">Email</dt>
            <dd class="text-right">
              <a
                href={`mailto:${siteConfig.social.email}`}
                class="break-all text-accent transition-colors hover:text-text"
              >
                {siteConfig.social.email}
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-7">
        <h3
          class="font-mono text-xs uppercase tracking-[0.2em] text-accent"
        >
          Current focus
        </h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            siteConfig.focus.map((item) => (
              <div
                class="rounded-xl border border-border bg-surface p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40"
              >
                <h4 class="font-semibold text-text">{item.title}</h4>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
