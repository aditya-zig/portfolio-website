---
interface Stage {
  label?: string;
  sub?: string;
  parallel?: [string, string] | string[];
}

interface Props {
  stages: Stage[];
  label: string;
}

const { stages, label } = Astro.props;
---

<div class="rounded-lg border border-border bg-surface-2 p-5">
  <p
    class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent"
    aria-hidden="true"
  >
    {label}
  </p>
  <ol class="mt-4 flex flex-col items-stretch" aria-label={label}>
    {
      stages.map((stage, i) => (
        <>
          {i > 0 && (
            <li class="flex justify-center py-1" aria-hidden="true">
              <svg
                width="16"
                height="24"
                viewBox="0 0 16 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="text-muted"
              >
                <path d="M8 0v16M8 16l-5-5M8 16l5-5" />
              </svg>
            </li>
          )}
          {stage.parallel ? (
            <li class="grid grid-cols-2 gap-3">
              {stage.parallel.map((item) => (
                <div class="rounded-md border border-border bg-bg px-3 py-2.5 text-center">
                  <span class="font-mono text-xs text-text">{item}</span>
                </div>
              ))}
            </li>
          ) : (
            <li class="rounded-md border border-accent/30 bg-bg px-3 py-2.5 text-center">
              <span class="block font-mono text-xs text-text">{stage.label}</span>
              {stage.sub && (
                <span
                  class="mt-0.5 block font-mono text-[10px] uppercase tracking-wider text-muted"
                >
                  {stage.sub}
                </span>
              )}
            </li>
          )}
        </>
      ))
    }
  </ol>
</div>