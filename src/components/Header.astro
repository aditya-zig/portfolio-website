---
import { siteConfig } from "../config";

const navLinks = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
  { label: "Education", href: "#education" },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div
    id="site-header"
    class="border-b border-transparent transition-colors duration-300"
  >
    <nav
      class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8"
      aria-label="Main"
    >
      <a
        href="#top"
        class="text-base font-bold tracking-tight text-text transition-colors hover:text-accent"
      >
        {siteConfig.wordmark.slice(0, -2)}
        <span class="text-accent">.S</span>
      </a>

      <div class="hidden items-center gap-7 md:flex">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-muted transition-colors hover:text-text"
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="hidden items-center gap-4 md:flex">
        {
          siteConfig.social.github && (
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="text-muted transition-colors hover:text-text"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social.linkedin && (
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="text-muted transition-colors hover:text-text"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M8 11v5" />
                <path d="M8 8v.01" />
                <path d="M12 16v-5" />
                <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              aria-label="Email"
              class="text-muted transition-colors hover:text-text"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                <path d="M3 7l9 6l9 -6" />
              </svg>
            </a>
          )
        }
        <a
          href={siteConfig.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-md border border-accent/40 px-3 py-1.5 text-xs text-accent transition-colors duration-200 hover:bg-accent hover:text-white"
        >
          Resume
        </a>
      </div>

      <button
        id="menu-button"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border text-text md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </nav>

    <div
      id="mobile-menu"
      class="hidden border-t border-border bg-bg px-4 pb-6 pt-3 md:hidden"
    >
      <nav class="flex flex-col gap-1" aria-label="Mobile">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="menu-link rounded-md px-3 py-2.5 text-sm text-text transition-colors hover:bg-surface"
          >
            {link.label}
          </a>
        ))}
      </nav>
      <div
        class="mt-4 flex items-center justify-between gap-4 border-t border-border px-3 pt-4"
      >
        <div class="flex items-center gap-4">
          {
            siteConfig.social.github && (
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                class="text-muted transition-colors hover:text-text"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social.linkedin && (
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="text-muted transition-colors hover:text-text"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M8 11v5" />
                  <path d="M8 8v.01" />
                  <path d="M12 16v-5" />
                  <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                  <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social.email && (
              <a
                href={`mailto:${siteConfig.social.email}`}
                aria-label="Email"
                class="text-muted transition-colors hover:text-text"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                  <path d="M3 7l9 6l9 -6" />
                </svg>
              </a>
            )
          }
        </div>
        <a
          href={siteConfig.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-md border border-accent/40 px-3 py-1.5 text-xs text-accent transition-colors duration-200 hover:bg-accent hover:text-white"
        >
          Resume
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) {
      header.classList.add("border-border", "bg-bg/90", "backdrop-blur-md");
    } else {
      header.classList.remove("border-border", "bg-bg/90", "backdrop-blur-md");
    }
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");
  const closeMenu = () => {
    menu?.classList.add("hidden");
    button?.setAttribute("aria-expanded", "false");
    button?.setAttribute("aria-label", "Open menu");
  };
  button?.addEventListener("click", () => {
    const nowHidden = menu?.classList.toggle("hidden");
    button.setAttribute("aria-expanded", String(!nowHidden));
    button.setAttribute("aria-label", nowHidden ? "Open menu" : "Close menu");
  });
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
  document.addEventListener("click", (event) => {
    if (
      menu &&
      !menu.classList.contains("hidden") &&
      !menu.contains(event.target) &&
      !button?.contains(event.target)
    ) {
      closeMenu();
    }
  });
</script>
