---

<div
  class={`relative min-h-56 overflow-hidden border border-border bg-surface-2 lg:min-h-0${className ? ` ${className}` : ""}`}
>
  <div class="blueprint-grid absolute inset-0" aria-hidden="true"></div>
  <span
    class="absolute left-4 top-4 font-mono text-[11px] uppercase tracking-[0.2em] text-muted"
  >
    {index} / {monogram}
  </span>
  <span
    class="absolute right-4 top-4 hidden max-w-[45%] truncate text-right font-mono text-[11px] uppercase tracking-[0.2em] text-accent sm:block"
  >
    {category}
  </span>
  <div
    class="absolute inset-0 flex items-center justify-center"
    set:html={motifs[motif] ?? motifs.chat}
  ></div>
</div>
