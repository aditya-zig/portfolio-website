    <rect x="92" y="72" width="30" height="6" rx="3"/>
    <rect x="56" y="90" width="38" height="6" rx="3"/>
    <rect x="92" y="90" width="30" height="6" rx="3"/>
    <rect x="56" y="108" width="20" height="6" rx="3" class="text-accent"/>
    <rect x="92" y="108" width="30" height="6" rx="3"/>
