    <circle cx="158" cy="66" r="2.5" class="text-accent" fill="currentColor" stroke="none"/>
  </svg>`,
  book: `<svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.5" class="h-36 w-36 text-muted sm:h-44 sm:w-44" aria-hidden="true">
    <path d="M34 34v13m0-13h13M166 34v13m0-13h-13M34 166v-13m0 13h13M166 166v-13m0 13h-13" stroke-opacity=".45"/>
