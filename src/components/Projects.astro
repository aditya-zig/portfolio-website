---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
import ProjectArt from "./ProjectArt.astro";
import Architecture from "./Architecture.astro";

const featured = siteConfig.projects.find((project) => project.featured);
const others = siteConfig.projects.filter((project) => !project.featured);
---

<section id="projects" class="border-t border-border">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <SectionHeading
      index="01"
      title="Projects"
      note="Selected work in automation, AI tooling, Python and game development."
    />

    {featured && (
      <article class="mt-12 overflow-hidden rounded-xl border border-border bg-surface transition-colors duration-300 hover:border-accent/50">
        <div class="grid lg:grid-cols-2">
          <div class="p-8 sm:p-10">
            <p class="flex flex-wrap items-center gap-3 font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
              <span>Featured / {featured.category}</span>
            </p>
            <h3 class="mt-4 text-2xl font-bold tracking-tight text-text sm:text-3xl">
              {featured.name}
            </h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {featured.skills.map((skill) => (
                <span class="rounded-md border border-border px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-muted">
                  {skill}
                </span>
              ))}
            </div>
            <p class="mt-5 text-sm leading-relaxed text-text sm:text-base">
              {featured.description}
            </p>

            <dl class="mt-8 space-y-6">
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
                  Why
                </dt>
                <dd class="mt-2 text-sm leading-relaxed text-muted">
                  {featured.why}
                </dd>
              </div>
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
                  How it works
                </dt>
                <dd class="mt-2 text-sm leading-relaxed text-muted">
                  {featured.how}
                </dd>
              </div>
            </dl>
          </div>

          <div class="border-t border-border bg-surface-2/60 p-8 sm:p-10 lg:border-l lg:border-t-0">
            <Architecture stages={featured.architecture} label="Architecture" />
            <dl class="mt-8 space-y-6">
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
                  What I learned
                </dt>
                <dd class="mt-2 text-sm leading-relaxed text-muted">
                  {featured.learned}
                </dd>
              </div>
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
                  Result
                </dt>
                <dd class="mt-2 text-sm leading-relaxed text-muted">
                  {featured.result}
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </article>
    )}

    <div class="mt-10 space-y-10">
      {
        others.map((project, i) => (
          <article
            class="group grid items-stretch overflow-hidden rounded-xl border border-border bg-surface transition-colors duration-300 hover:border-accent/50 lg:grid-cols-2"
          >
            <ProjectArt
              class={i % 2 === 1 ? "lg:order-first" : ""}
              motif={project.motif}
              monogram={project.monogram}
              index={`0${i + 2}`}
              category={project.category}
            />
            <div class="p-8 sm:p-10">
              <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
                {project.category}
              </p>
              <h3 class="mt-3 text-xl font-bold tracking-tight text-text sm:text-2xl">
                {project.name}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">
                {project.description}
              </p>
              <div class="mt-5 flex flex-wrap gap-2">
                {project.skills.map((skill) => (
                  <span class="rounded-md border border-border px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-muted transition-colors duration-200 group-hover:border-accent/40 group-hover:text-text">
                    {skill}
                  </span>
                ))}
              </div>

              {project.architecture && (
                <div class="mt-6 max-w-xs">
                  <Architecture stages={project.architecture} label="Flow" />
                </div>
              )}

              <dl class="mt-6 space-y-4">
                <div>
                  <dt class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
                    What I learned
                  </dt>
                  <dd class="mt-1.5 text-sm leading-relaxed text-muted">
                    {project.learned}
                  </dd>
                </div>
                {project.result && (
                  <div>
                    <dt class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
                      Result
                    </dt>
                    <dd class="mt-1.5 text-sm leading-relaxed text-muted">
                      {project.result}
                    </dd>
                  </div>
                )}
              </dl>

              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 inline-flex items-center gap-2 rounded-md border border-accent/40 px-3 py-1.5 text-xs text-accent transition-colors duration-200 hover:bg-accent hover:text-white"
                >
                  GitHub ↗
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>