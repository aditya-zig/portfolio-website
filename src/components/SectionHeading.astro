---
interface Props {
  index: string;
  title: string;
  note?: string;
}

const { index, title, note } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-6">
  <div>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
      {index} / {title}
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">
      {title}
    </h2>
  </div>
  {note && (
    <p class="max-w-xs text-sm leading-relaxed text-muted">{note}</p>
  )}
</div>
