---
import { siteConfig } from "../config";

const navLinks = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
  { label: "Education", href: "#education" },
];
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <a
          href="#top"
          class="text-base font-bold tracking-tight text-text transition-colors hover:text-accent"
        >
          {siteConfig.wordmark.slice(0, -2)}
          <span class="text-accent">.S</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          Building software, automation &amp; AI systems from Bangalore, India.
        </p>
      </div>

      <nav aria-label="Footer">
        <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">
          Navigate
        </h3>
        <ul class="mt-4 space-y-2.5">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted transition-colors hover:text-text"
              >
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a
              href={siteConfig.resume}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted transition-colors hover:text-text"
            >
              Resume
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">
          Connect
        </h3>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="break-all text-sm text-muted transition-colors hover:text-accent"
            >
              {siteConfig.social.email}
            </a>
          </li>
          <li>
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted transition-colors hover:text-accent"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted transition-colors hover:text-accent"
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-xs text-muted">© {new Date().getFullYear()} Aditya S.</p>
      <p class="text-xs text-muted">{siteConfig.location}</p>
    </div>
  </div>
</footer>
