---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
---

<section id="education" class="border-t border-border">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <SectionHeading
      index="04"
      title="Education"
      note="B.Tech in Information Science Engineering, in progress."
    />

    {
      siteConfig.education.length > 0 && (
        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          {siteConfig.education.map((edu) => (
            <article class="rounded-xl border border-border bg-surface p-7 sm:p-8">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <h3
                  class="text-xl font-bold tracking-tight text-text sm:text-2xl"
                >
                  {edu.degree}
                </h3>
                <span class="font-mono text-xs text-accent">
                  {edu.dateRange}
                </span>
              </div>
              <p class="mt-2 text-sm text-muted">{edu.school}</p>
              <ul class="mt-6 space-y-3">
                {edu.achievements.map((achievement) => (
                  <li class="flex items-start gap-3 text-sm leading-relaxed text-muted">
                    <span
                      class="mt-2 h-1 w-1 flex-none rounded-full bg-accent"
                      aria-hidden="true"
                    ></span>
                    {achievement}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
