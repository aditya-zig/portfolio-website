---
import { siteConfig } from "../config";
---

<section class="relative overflow-hidden">
  <div
    class="blueprint-grid pointer-events-none absolute inset-0"
    aria-hidden="true"
  ></div>
  <div
    class="relative mx-auto flex min-h-svh max-w-6xl flex-col items-start justify-center px-4 pb-24 pt-32 sm:px-6 lg:px-8"
  >
    <p
      class="inline-flex items-center gap-2.5 rounded-full border border-border bg-surface px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-[0.18em] text-muted"
    >
      <span
        class="h-1.5 w-1.5 rounded-full bg-accent"
        aria-hidden="true"
      ></span>
      {siteConfig.hero.status}
    </p>
    <h1
      class="mt-8 max-w-3xl text-4xl font-bold leading-[1.1] tracking-tight text-text sm:text-5xl lg:text-6xl"
    >
      Building software, <span class="text-accent">automation &amp; AI</span>
      systems.
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
      {siteConfig.hero.sub}
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href="#projects" class="btn btn-primary">View my work</a>
      {
        siteConfig.social.github && (
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            GitHub
          </a>
        )
      }
    </div>
  </div>
</section>
