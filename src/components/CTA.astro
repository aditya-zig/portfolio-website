---
import { siteConfig } from "../config";
---

<section id="contact" class="border-t border-border">
  <div
    class="mx-auto max-w-6xl px-4 py-24 text-center sm:px-6 sm:py-32 lg:px-8"
  >
    <h2
      class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-text sm:text-4xl lg:text-5xl"
    >
      {siteConfig.cta.heading}
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
      {siteConfig.cta.text}
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href={`mailto:${siteConfig.social.email}`} class="btn btn-primary">
        Email Me
      </a>
      {
        siteConfig.social.linkedin && (
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            LinkedIn
          </a>
        )
      }
      <a href={siteConfig.resume} download class="btn btn-secondary">
        Download Resume
      </a>
    </div>
  </div>
</section>
